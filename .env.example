# ==============================================================================
# Environment Configuration Template for SQAM Analyzer
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# OpenAI API Key (Required if using --provider openai)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Required if using --provider gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local Ollama / vLLM / OpenAI-Compatible Endpoint
# OPENAI_BASE_URL=http://localhost:11434/v1
