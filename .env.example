# ==============================================================================
# Environment Configuration Template for SQAM Analyzer
# Copy this file to .env and configure at least ONE live LLM key:
#   cp .env.example .env
#
# MANDATORY: An LLM backend (Google Gemini or OpenAI) is strictly required to
# run quality analysis, defect reasoning, surgical refinement, and evaluation.
# ==============================================================================

# Option 1: Google Gemini API Key (Recommended for speed and cost)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Local Ollama / vLLM / OpenAI-Compatible Endpoint
# OPENAI_BASE_URL=http://localhost:11434/v1

